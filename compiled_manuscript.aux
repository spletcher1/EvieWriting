\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Manipulation of ellipsoid body neurons ER2 and ER4 extends lifespan in female and male flies.} \textbf  {(A)} Flies were mated for two days, then separated by sex and sorted 20/vial onto all-trans retinal food for 24 hours before optogenetic treatment began. \textbf  {(B--D)} (Left) Expression patterns of drivers used in each experiment. Neurons were either activated (dashed red lines) using UAS-CsChrimson, or inhibited (dashed green lines) using UAS-GtACR1. Dark controls (black lines) were included for all experiments. P-values were obtained by log-rank analysis of correspondingly colored lines. Control genotypes (solid lines) were bred by crossing respective GAL4 drivers with WCS. \textbf  {(B)} Activation of ER2 extended lifespan in both sexes. n = 95-117. \textbf  {(C)} Inhibition of ER4d extended lifespan in both sexes. n = 145-189. \textbf  {(D)} Simultaneous activation of ER2 and ER4 neurons extended lifespan in both sexes. n = 127-139. \textbf  {(E)} Inhibition (left) and activation (right) of broader EB (BDSC \#39805) modestly extended lifespan in females. GtACR1 n = 127-133; Chr n = 95-115. \textbf  {(B--E)} P-values were obtained by log-rank analysis of line pairs indicated by color. }}{39}{figure.caption.34}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:lifespanfig}{{1}{39}{\textbf {Manipulation of ellipsoid body neurons ER2 and ER4 extends lifespan in female and male flies.} \textbf {(A)} Flies were mated for two days, then separated by sex and sorted 20/vial onto all-trans retinal food for 24 hours before optogenetic treatment began. \textbf {(B--D)} (Left) Expression patterns of drivers used in each experiment. Neurons were either activated (dashed red lines) using UAS-CsChrimson, or inhibited (dashed green lines) using UAS-GtACR1. Dark controls (black lines) were included for all experiments. P-values were obtained by log-rank analysis of correspondingly colored lines. Control genotypes (solid lines) were bred by crossing respective GAL4 drivers with WCS. \textbf {(B)} Activation of ER2 extended lifespan in both sexes. n = 95-117. \textbf {(C)} Inhibition of ER4d extended lifespan in both sexes. n = 145-189. \textbf {(D)} Simultaneous activation of ER2 and ER4 neurons extended lifespan in both sexes. n = 127-139. \textbf {(E)} Inhibition (left) and activation (right) of broader EB (BDSC \#39805) modestly extended lifespan in females. GtACR1 n = 127-133; Chr n = 95-115. \textbf {(B--E)} P-values were obtained by log-rank analysis of line pairs indicated by color}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {ER2 activation drives broad transcriptional changes and produces a head transcriptomic profile distinct from ER4d inhibition.} Bulk RNA-seq data from whole heads of female flies treated with light for 1 week shows broad transcriptomic changes in ER2>Chr flies. Ten heads were collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf  {(A)} DEGs downregulated (left) and upregulated (right) by ER2 activation (ER2>Chr). \textbf  {(B)} Top 15 GO Biological Processes upregulated by ER2 activation. \textbf  {(C)} Top 11 GO Biological Processes downregulated by ER2 activation. \textbf  {(D)} DEGs driven by ER4d inhibition (ER4d>GtACR1). }}{40}{figure.caption.35}\protected@file@percent }
\newlabel{fig:seqfig}{{2}{40}{\textbf {ER2 activation drives broad transcriptional changes and produces a head transcriptomic profile distinct from ER4d inhibition.} Bulk RNA-seq data from whole heads of female flies treated with light for 1 week shows broad transcriptomic changes in ER2>Chr flies. Ten heads were collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf {(A)} DEGs downregulated (left) and upregulated (right) by ER2 activation (ER2>Chr). \textbf {(B)} Top 15 GO Biological Processes upregulated by ER2 activation. \textbf {(C)} Top 11 GO Biological Processes downregulated by ER2 activation. \textbf {(D)} DEGs driven by ER4d inhibition (ER4d>GtACR1)}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {ER2/ER4 activation shares little transcriptomic overlap with ER2 activation or ER4d inhibition.} Bulk RNA-seq data from whole heads of female flies treated with light for 1 week. Ten heads were collected per sample. Heatmap shows differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf  {(A)} DEGs downregulated (left) and upregulated (right) by ER2/ER4 activation (ER2/ER4>Chr). \textbf  {(B)} Top 15 GO Biological Processes upregulated by ER2/ER4 activation. \textbf  {(C)} Top 7 GO Biological Processes downregulated by ER2/ER4 activation. \textbf  {(D)} Overlap between upregulated head genes in all 3 manipulations. \textbf  {(E)} Overlap between downregulated head genes in all 3 manipulations. }}{41}{figure.caption.36}\protected@file@percent }
\newlabel{fig:seqfig2}{{3}{41}{\textbf {ER2/ER4 activation shares little transcriptomic overlap with ER2 activation or ER4d inhibition.} Bulk RNA-seq data from whole heads of female flies treated with light for 1 week. Ten heads were collected per sample. Heatmap shows differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf {(A)} DEGs downregulated (left) and upregulated (right) by ER2/ER4 activation (ER2/ER4>Chr). \textbf {(B)} Top 15 GO Biological Processes upregulated by ER2/ER4 activation. \textbf {(C)} Top 7 GO Biological Processes downregulated by ER2/ER4 activation. \textbf {(D)} Overlap between upregulated head genes in all 3 manipulations. \textbf {(E)} Overlap between downregulated head genes in all 3 manipulations}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {ER2 and ER2/ER4 activation dissociates nutrient-state signaling from behavioral and physiological outputs.} \textbf  {(A-D)} Interaction (light $\times $ genotype) p-values derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex and driver, and across time points for con-ex. Female TAG points represent 5 flies; all others represent 10 flies. \textbf  {(A)} ER2-GAL4 con-ex. ER2-activated females were indistinguishable from controls. Naïve and one-week pre-treated males were indistinguishable from controls, but male feeding was reduced after one month of pre-treatment. Female n = 8-10; male n = 7-10. \textbf  {(B)} ER2/ER4-GAL4 con-ex. ER2/ER4 activated males and females were indistinguishable from controls at all time points. Female n = 7-10; male n = 18-20 (naïve), 6-10 (1 week), 4-6 (1 month). \textbf  {(C)} ER2-GAL4 TAG levels were reduced for males, but not females. n = 10 for both sexes. \textbf  {(D)} ER2/ER4-GAL4 TAG levels were reduced for both sexes. Female n = 9-10; male n = 8-10. \textbf  {(E-F)} Starvation assays for ER2-GAL4 and ER2/ER4-GAL4 females and males. Flies were pre-treated with light for 1 week before transfer to starvation medium. P-values were obtained by log-rank analysis of correspondingly colored lines. n = 96-100. }}{42}{figure.caption.37}\protected@file@percent }
\newlabel{fig:conexfig}{{4}{42}{\textbf {ER2 and ER2/ER4 activation dissociates nutrient-state signaling from behavioral and physiological outputs.} \textbf {(A-D)} Interaction (light $\times $ genotype) p-values derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex and driver, and across time points for con-ex. Female TAG points represent 5 flies; all others represent 10 flies. \textbf {(A)} ER2-GAL4 con-ex. ER2-activated females were indistinguishable from controls. Naïve and one-week pre-treated males were indistinguishable from controls, but male feeding was reduced after one month of pre-treatment. Female n = 8-10; male n = 7-10. \textbf {(B)} ER2/ER4-GAL4 con-ex. ER2/ER4 activated males and females were indistinguishable from controls at all time points. Female n = 7-10; male n = 18-20 (naïve), 6-10 (1 week), 4-6 (1 month). \textbf {(C)} ER2-GAL4 TAG levels were reduced for males, but not females. n = 10 for both sexes. \textbf {(D)} ER2/ER4-GAL4 TAG levels were reduced for both sexes. Female n = 9-10; male n = 8-10. \textbf {(E-F)} Starvation assays for ER2-GAL4 and ER2/ER4-GAL4 females and males. Flies were pre-treated with light for 1 week before transfer to starvation medium. P-values were obtained by log-rank analysis of correspondingly colored lines. n = 96-100}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {EB manipulation does not impair climbing ability.} Height reached by 9 sec after drop (top plots of each panel) and total up distance climbed in 30 sec after drop (bottom plots). Interaction (light $\times $ genotype) p-values were derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex/driver and across time points and climbing metrics. Points represent average of 3 trials per individual. n = 23-28. \textbf  {(A-B)} One week of activation had no effect on ER2 and ER2/ER4 males and females. Female ER2/ER4 flies exhibit improved climbing by both metrics after one month of activation; ER2 females, ER2 males, and ER2/ER4 males exhibit no change after one month. \textbf  {(C)} ER4d>GtACR1 males, but not females, show improved climbing ability after both one week and five weeks of inhibition. }}{43}{figure.caption.38}\protected@file@percent }
\newlabel{fig:ddropfig}{{5}{43}{\textbf {EB manipulation does not impair climbing ability.} Height reached by 9 sec after drop (top plots of each panel) and total up distance climbed in 30 sec after drop (bottom plots). Interaction (light $\times $ genotype) p-values were derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex/driver and across time points and climbing metrics. Points represent average of 3 trials per individual. n = 23-28. \textbf {(A-B)} One week of activation had no effect on ER2 and ER2/ER4 males and females. Female ER2/ER4 flies exhibit improved climbing by both metrics after one month of activation; ER2 females, ER2 males, and ER2/ER4 males exhibit no change after one month. \textbf {(C)} ER4d>GtACR1 males, but not females, show improved climbing ability after both one week and five weeks of inhibition}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {FLIC captures distinct valence states induced by EB manipulation.} Female flies were used to assay valence of neuron activation. Sucrose interaction p-values were derived from the genotype $\times $ linkage interaction term of a linear mixed model (Interactions ~ Genotype * Linkage + (1|Group), lmer) with yoked pairs modeled as a random intercept. Benjamini-Hochberg correction was applied within each sex and driver and across time points. \textbf  {(A)} A "trigger" fly (top chamber) controlled optogenetic light for itself and a yoked control (bottom) by touching a 10\% sucrose (S10) well. \textbf  {(B)} ER2 activation was aversive in light-naïve flies and in flies pre-treated with light for 1 month. n = 9-18. \textbf  {(C)} ER4d activation was transiently aversive in flies pre-treated with light for 1 week. n = 13-18. \textbf  {(D)} After correction, ER2/ER4 flies were indistinguishable from yoked controls. Before correction, light-naïve flies found the well rewarding (p = 0.020). n = 10-18. }}{44}{figure.caption.39}\protected@file@percent }
\newlabel{fig:flicfig}{{6}{44}{\textbf {FLIC captures distinct valence states induced by EB manipulation.} Female flies were used to assay valence of neuron activation. Sucrose interaction p-values were derived from the genotype $\times $ linkage interaction term of a linear mixed model (Interactions ~ Genotype * Linkage + (1|Group), lmer) with yoked pairs modeled as a random intercept. Benjamini-Hochberg correction was applied within each sex and driver and across time points. \textbf {(A)} A "trigger" fly (top chamber) controlled optogenetic light for itself and a yoked control (bottom) by touching a 10\% sucrose (S10) well. \textbf {(B)} ER2 activation was aversive in light-naïve flies and in flies pre-treated with light for 1 month. n = 9-18. \textbf {(C)} ER4d activation was transiently aversive in flies pre-treated with light for 1 week. n = 13-18. \textbf {(D)} After correction, ER2/ER4 flies were indistinguishable from yoked controls. Before correction, light-naïve flies found the well rewarding (p = 0.020). n = 10-18}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Valence of EB manipulation is sex-, circuit-, and context-dependent.} \textbf  {(A)} Light-naïve flies (n = 34-36) were placed in lanes with a dark side and an illuminated side (red light, 48 Hz) and subjected to a two-phase protocol: 1) a 10-min dark acclimation period; 2) a 60-min treatment of 5 sec on/5 sec off. Reported p-values for Preference Index correspond to genotype $\times $ phase interaction term. \textbf  {(B)} ER2/ER4>Chr females and males strongly preferred lit side of arena. \textbf  {(C)} ER2>Chr females, but not males, preferred the unlit side. \textbf  {(D)} ER4d>Chr females preferred lit side, but showed decreased light preference relative to controls. Males preferred unlit side. }}{45}{figure.caption.40}\protected@file@percent }
\newlabel{fig:arenafig}{{7}{45}{\textbf {Valence of EB manipulation is sex-, circuit-, and context-dependent.} \textbf {(A)} Light-naïve flies (n = 34-36) were placed in lanes with a dark side and an illuminated side (red light, 48 Hz) and subjected to a two-phase protocol: 1) a 10-min dark acclimation period; 2) a 60-min treatment of 5 sec on/5 sec off. Reported p-values for Preference Index correspond to genotype $\times $ phase interaction term. \textbf {(B)} ER2/ER4>Chr females and males strongly preferred lit side of arena. \textbf {(C)} ER2>Chr females, but not males, preferred the unlit side. \textbf {(D)} ER4d>Chr females preferred lit side, but showed decreased light preference relative to controls. Males preferred unlit side}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {ER2 activation produces transcriptional signatures in the periphery that are distinct from those in the head.} Bulk RNA-seq data were acquired from whole bodies of ER2-GAL4 flies treated with light for 1 week. 5 bodies collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf  {(A)} Overlap between all DEGs observed in ER2-activated heads (purple) and bodies (green). Shared genes are indicated by 2 red arrows (upregulated) or a red and blue arrow (oppositely regulated in heads and bodies; red = upregulated in heads, blue = downregulated in heads). \textbf  {(B)} Top 15 peripheral GO Biological Processes downregulated by ER2 activation. \textbf  {(C)} Top 15 peripheral GO Biological Processes upregulated by ER2 activation. }}{46}{figure.caption.41}\protected@file@percent }
\newlabel{fig:bodyseqfig}{{8}{46}{\textbf {ER2 activation produces transcriptional signatures in the periphery that are distinct from those in the head.} Bulk RNA-seq data were acquired from whole bodies of ER2-GAL4 flies treated with light for 1 week. 5 bodies collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf {(A)} Overlap between all DEGs observed in ER2-activated heads (purple) and bodies (green). Shared genes are indicated by 2 red arrows (upregulated) or a red and blue arrow (oppositely regulated in heads and bodies; red = upregulated in heads, blue = downregulated in heads). \textbf {(B)} Top 15 peripheral GO Biological Processes downregulated by ER2 activation. \textbf {(C)} Top 15 peripheral GO Biological Processes upregulated by ER2 activation}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {ER2 activation remodels peripheral metabolism.} Targeted metabolomic profiling at FDR < 0.05 (light $\times $ genotype interaction; Benjamini–Hochberg correction). 30 bodies collected per sample. \textbf  {(A)} PC1 separates ER2-activated flies from all other samples. \textbf  {(B)} 87 metabolites were significantly affected by ER2 neuron activation (40 up/47 down). \textbf  {(C)} Peripheral metabolites reduced (left) or increased (right) in abundance upon ER2 activation. Red light treatment separates ER2>Chr flies from all 3 control conditions. \textbf  {(D)} KEGG pathway enrichment of significantly altered metabolites (FELLA). Dot color and x-axis indicate statistical significance ($-\log  _{10}(p)$). }}{47}{figure.caption.42}\protected@file@percent }
\newlabel{fig:metabfig}{{9}{47}{\textbf {ER2 activation remodels peripheral metabolism.} Targeted metabolomic profiling at FDR < 0.05 (light $\times $ genotype interaction; Benjamini–Hochberg correction). 30 bodies collected per sample. \textbf {(A)} PC1 separates ER2-activated flies from all other samples. \textbf {(B)} 87 metabolites were significantly affected by ER2 neuron activation (40 up/47 down). \textbf {(C)} Peripheral metabolites reduced (left) or increased (right) in abundance upon ER2 activation. Red light treatment separates ER2>Chr flies from all 3 control conditions. \textbf {(D)} KEGG pathway enrichment of significantly altered metabolites (FELLA). Dot color and x-axis indicate statistical significance ($-\log _{10}(p)$)}{figure.caption.42}{}}
\providecommand\NAT@force@numbers{}\NAT@force@numbers
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {ER4d activation modestly extends lifespan in males and females.} Flies were mated for two days, then separated by sex and sorted onto all-trans retinal food for 24 hours before optogenetic treatment began. Neurons were activated using UAS-CsChrimson (red lines). Dark controls (black lines) were included for all experiments. P-values were obtained by log-rank analysis of line pairs indicated by color. n = 180-193.}}{49}{figure.caption.44}\protected@file@percent }
\newlabel{fig:lifespansupp}{{S1}{49}{\textbf {ER4d activation modestly extends lifespan in males and females.} Flies were mated for two days, then separated by sex and sorted onto all-trans retinal food for 24 hours before optogenetic treatment began. Neurons were activated using UAS-CsChrimson (red lines). Dark controls (black lines) were included for all experiments. P-values were obtained by log-rank analysis of line pairs indicated by color. n = 180-193}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {DDrop supplement.} Height reached by 9 sec after drop (top plots of each panel) and total up distance climbed in 30 sec after drop (bottom plots). Interaction (light $\times $ genotype) p-values were derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex and driver and across time points and climbing metrics. Points represent average of 3 trials per individual. n = 20-24. \textbf  {(A)} ER4d activation has no effect on climbing ability of females or males. \textbf  {(B)} Broader EB inhibition has no effect on climbing ability of females or males. }}{50}{figure.caption.45}\protected@file@percent }
\newlabel{fig:ddropsupp}{{S2}{50}{\textbf {DDrop supplement.} Height reached by 9 sec after drop (top plots of each panel) and total up distance climbed in 30 sec after drop (bottom plots). Interaction (light $\times $ genotype) p-values were derived from 2-way ANOVAs. Benjamini-Hochberg correction was applied within each sex and driver and across time points and climbing metrics. Points represent average of 3 trials per individual. n = 20-24. \textbf {(A)} ER4d activation has no effect on climbing ability of females or males. \textbf {(B)} Broader EB inhibition has no effect on climbing ability of females or males}{figure.caption.45}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Self-administration of optogenetic activation in FLIC drives nuanced appetitive and aversive behaviors.} \textbf  {(A, C-E)} P-values were derived from the genotype $\times $ linkage interaction term of a linear mixed model (Outcome ~ Genotype * Linkage + (1|Group), lmer) with yoked pairs modeled as a random intercept. \textbf  {(A)} Naïve ER2>Chr flies spent less time at the S10 well per visit (left), but approached it as often as controls (right). n = 13-18. \textbf  {(B)} (Left) A "trigger" fly (top chamber, ER2>WCS) controlled optogenetic light for itself, a yoked genetic control (middle chamber), and a yoked ER2>Chr fly (bottom chamber) by touching a 10\% sucrose (S10) well. (Right) Naïve ER2>Chr flies did not interact with the well more often than yoked genetic controls, indicating no global, non-associative effects of ER2 activation on feeding. P-values were derived from planned contrasts on a linear mixed model (Interactions ~ Condition + (1|Group), lmer) with the yoked pairing structure modeled as a random intercept. n = 16-18. \textbf  {(C)} Naïve ER4d>GtACR1 interactions were indistinguishable from controls, as all flies were startled by onset of green light. n = 13-18. \textbf  {(D)} Naïve ER4d>Chr trigger flies, like ER2 flies, spent less time at the well per visit (left) but returned as frequently as controls (right). n = 13-17. \textbf  {(E)} ER2/ER4>Chr trigger flies spent the same amount of time per visit at wells (left) but visited more frequently than controls (right). n = 10-18. }}{52}{figure.caption.47}\protected@file@percent }
\newlabel{fig:flicsupp}{{S2}{52}{\textbf {Self-administration of optogenetic activation in FLIC drives nuanced appetitive and aversive behaviors.} \textbf {(A, C-E)} P-values were derived from the genotype $\times $ linkage interaction term of a linear mixed model (Outcome ~ Genotype * Linkage + (1|Group), lmer) with yoked pairs modeled as a random intercept. \textbf {(A)} Naïve ER2>Chr flies spent less time at the S10 well per visit (left), but approached it as often as controls (right). n = 13-18. \textbf {(B)} (Left) A "trigger" fly (top chamber, ER2>WCS) controlled optogenetic light for itself, a yoked genetic control (middle chamber), and a yoked ER2>Chr fly (bottom chamber) by touching a 10\% sucrose (S10) well. (Right) Naïve ER2>Chr flies did not interact with the well more often than yoked genetic controls, indicating no global, non-associative effects of ER2 activation on feeding. P-values were derived from planned contrasts on a linear mixed model (Interactions ~ Condition + (1|Group), lmer) with the yoked pairing structure modeled as a random intercept. n = 16-18. \textbf {(C)} Naïve ER4d>GtACR1 interactions were indistinguishable from controls, as all flies were startled by onset of green light. n = 13-18. \textbf {(D)} Naïve ER4d>Chr trigger flies, like ER2 flies, spent less time at the well per visit (left) but returned as frequently as controls (right). n = 13-17. \textbf {(E)} ER2/ER4>Chr trigger flies spent the same amount of time per visit at wells (left) but visited more frequently than controls (right). n = 10-18}{figure.caption.47}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Stimulation frequency modulates EB-driven valence.} Light-naïve flies were placed in lanes with a dark side and an illuminated side (red light at 200 Hz or green light at 40 Hz) and subjected to a two-phase protocol: 1) a 10-min dark acclimation period; 2) a 60-min treatment of 5 sec on/5 sec off. Reported p-values for Preference Index correspond to genotype $\times $ phase interaction term. \textbf  {(A)} ER2/ER4>Chr females and males preferred the lit side. n = 34-36. \textbf  {(B)} ER2>Chr females preferred the unlit side. Males were indistinguishable from controls. n = 35-36. \textbf  {(C)} ER4d>GtACR1 females (n = 26-27) and males (n = 17-18) were indistinguishable from controls. \textbf  {(D)} ER4d>Chr females and males were indistinguishable from controls. n = 34-36. }}{53}{figure.caption.48}\protected@file@percent }
\newlabel{fig:arenasupp}{{S3}{53}{\textbf {Stimulation frequency modulates EB-driven valence.} Light-naïve flies were placed in lanes with a dark side and an illuminated side (red light at 200 Hz or green light at 40 Hz) and subjected to a two-phase protocol: 1) a 10-min dark acclimation period; 2) a 60-min treatment of 5 sec on/5 sec off. Reported p-values for Preference Index correspond to genotype $\times $ phase interaction term. \textbf {(A)} ER2/ER4>Chr females and males preferred the lit side. n = 34-36. \textbf {(B)} ER2>Chr females preferred the unlit side. Males were indistinguishable from controls. n = 35-36. \textbf {(C)} ER4d>GtACR1 females (n = 26-27) and males (n = 17-18) were indistinguishable from controls. \textbf {(D)} ER4d>Chr females and males were indistinguishable from controls. n = 34-36}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {ER2 activation drives extensive changes in the peripheral transcriptome.} Bulk RNA-seq data from headless bodies of female flies treated with light for 1 week. 5 bodies collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf  {(A)} DEGs downregulated (left) and upregulated (right) by ER2 activation (ER2>Chr). }}{54}{figure.caption.49}\protected@file@percent }
\newlabel{fig:bodyseqsupp}{{S4}{54}{\textbf {ER2 activation drives extensive changes in the peripheral transcriptome.} Bulk RNA-seq data from headless bodies of female flies treated with light for 1 week. 5 bodies collected per sample. Differentially expressed genes (DEGs) identified at FDR < 0.01 (Benjamini-Hochberg correction) using DESeq2 R package. \textbf {(A)} DEGs downregulated (left) and upregulated (right) by ER2 activation (ER2>Chr)}{figure.caption.49}{}}
